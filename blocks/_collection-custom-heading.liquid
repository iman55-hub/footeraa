  {% comment %}
   blocks/_collection-custom-heading
  {% endcomment %}
  <div class="section-header">
    {% if block.settings.showline %}
    <span class="gold-line"></span>
    {% endif %}
    <h2 class="section-title">{{ block.settings.heading }}</h2>
    {% if block.settings.showline %}
    <span class="gold-line"></span>
     {% endif %}
  </div>
{% stylesheet %}
  .section-header{
  text-align: center;
  margin-bottom: 50px;
  display: flex;
  gap:2px;
  justify-content: center;
  align-items: center;
}

.section-title{
  font-size: clamp(29px,5.7vw,54px);
  font-weight: 500;
  letter-spacing: 1px;
}

.gold-line {
  display: block;
  width: 80px; /* apni need ke hisaab se change kar sakti ho */
  height: 6px;
  border-radius: 50px;
  background: linear-gradient(
    to right,
    transparent,
    #E6AF10 ,
    transparent
  );
}

{% endstylesheet %}
{% schema %}
{
    "name": "Slider Heading",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default":"Shop By Collection"
      },
      {
        "type":"checkbox",
        "id":"showline",
        "label":"Show Lines",
        "default":true
      },
    ],
    "presets": [
      {
        "name": "Slider Heading"
      }
    ]
}
{% endschema %}