{% comment %}
  blocks/my-collection-card
{% endcomment %}
<div class="my-collection-card">
            {% if collection.image %}
              {{ collection.image | image_url: width: 1200 | image_tag:class:"mycollectionimg" }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'my-col-slider-placeholder' }}
            {% endif %}
            <div class="my-collection-content">
            <h3>{{ collection.title }}</h3>
            {% if block.settings.showlink %}
            <a href="{{ collection.url }}" class="view-all">{{ block.settings.linktext }}</a>
            {% endif %}
          </div>
      </div>
{% schema %}
{
    "name":"Collection Card",
    "settings": [
      {
        "type": "checkbox",
        "id": "showlink",
        "label": "Show link",
        "default":true,
      },
      {
        "type": "text",
        "label": "Link Text",
        "id": "linktext",
        "default": "View All →"
      }
    ],
    "presets": [
        {
         "name":"Collection Card"   
        }
    ]

}
{% endschema %}