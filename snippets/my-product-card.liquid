<div class="my-product-card">
{% if product.featured_image!=blank %}
  <a href="{{ product.selected_or_first_available_variant.url}}" class="{% if product.selected_or_first_available_variant.available!=true %}disabled{% endif %}" data-product-available="{{ product.selected_or_first_available_variant.available }}">
{{ product.featured_image | image_url: width: 800 |image_tag: class:"bestseller-img",alt:product.title|escape }}
</a>
{% endif %}
<div class="best-seller-details">
<h3>{{ product.title | escape }}</h3>
<p>{{ product.selected_or_first_available_variant.price | money_without_currency }}</p>
<div>
<a href="{{ product.selected_or_first_available_variant.url}}" class="best-seller-button" data-product-available="{{ product.selected_or_first_available_variant.available }}">
   View Details
</a>  
<button class="best-seller-cart-add {% if product.selected_or_first_available_variant.available!=true %}disabled{% endif %}" data-product-id="{{ product.selected_or_first_available_variant.id }}" data-product-available="{{ product.selected_or_first_available_variant.available }}">
  {% if product.selected_or_first_available_variant.available==true %}Add To Cart{% else %}Sold Out{% endif %}
</button>
</div>
<p class="error hide"></p>
</div>
</div>
{% stylesheet %}
   .my-product-card{
    container-type: inline-size;
}
  .bestseller-img{
   width: 100%;
   display: block;
   height: auto;
   aspect-ratio: 1/1;
   object-fit: cover;
   transition: transform .3s ease-in-out;
   cursor:pointer;
  }
 .bestseller-img:hover,.best-seller-button:hover{
  transform: scale(1.05);
}
.best-seller-details{
 padding: 10px;
 display: flex;
 flex-direction: column;
 align-items: flex-start;
 gap:4px;
 color:#111111;
}
.best-seller-details h3{
font-size: clamp(0.5rem, 5cqw, 1.375rem);
margin:0;
}
.best-seller-details p{
font-size: clamp(0.4rem, 4cqw, 1.125rem);
font-weight: 600;
margin:0;

}
.best-seller-button {
    text-decoration: none;
    border: 1px solid black;
    font-size: clamp(0.3rem, 3.5cqw, 0.875rem);
    color: #1C1C1C;
    padding: 8px;
    border-radius: 10px;
    margin:0;
}
.best-seller-cart-add{
 color: #fff;
    font-size: clamp(0.3rem, 3.5cqw, 0.875rem);
    background-color: #1C1C1C;
    padding: 10px;
    border-radius: 10px;
    margin:0;
    border: none;
    margin-left:2px;
    transition: all 0.2s;
    cursor: pointer;
}
.disabled{
 pointer-events: none; 
  cursor: default; 
  background-color: #888888; 
  color:white;
}
.error{
font-size: 10px;
color: red;
}
.hide{
  visibility: hidden;
}
{% endstylesheet %}