{% comment %}
 sections/popup-products
 {% endcomment %}
<section class="popup-section">
    <h2 class="popup-sec-heading" style="--text-alignment:{{section.settings.text_alignment}};">
        {{ section.settings.popup_sec_heading}}</h2>
    {% capture children %}
    {% for product in section.settings.popup_product %}
        {% content_for 'block', type:'_my-custom-card',id:"mypopuproductcard",item:product,section_id: section.id %}
    {% endfor %}  
{% endcapture %} 
{% render 'my-product-grid' children:children %}
</section>   
{% stylesheet %}
  .popup-section{
    padding: 3.5rem;
    max-width:1250px;
    margin:0 auto;
  }
  .popup-sec-heading{
    font-size:clamp(22px,2vw, 26.4px);
    text-align:var(--text-alignment);
    margin-bottom:35px;
}
{% endstylesheet %}
{% schema %} 
{
    "name":"Products with Popup",
    "settings":[
        {
            "type":"text",
            "id":"popup_sec_heading",
            "label":"Heading",
            "default":"MERCH"
        },
        {
            "type":"text_alignment",
            "id":"text_alignment",
            "label":"Text Alignment",
            "default":"center"
        },
        {
            "type":"product_list",
            "id":"popup_product",
            "label":"Select Product",
            "limit":8
        }
    ],
    "presets": [
        {
            "name":"Products with Popup",
        }
    ]
}
{% endschema %} 